# W2A_CDP_PORT   - Chrome remote debugging port on 127.0.0.1 only (default: 9222)
# W2A_PORT       - API server port (default: 8080)
# W2A_HOST       - API server host (default: 127.0.0.1)
# W2A_HEADLESS   - Run Chrome headless: true/false (default: false)
# W2A_CHROME_EXTRA_ARGS - Extra Chrome flags, shell-style quoted
# W2A_LOG_LEVEL  - Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)

# Uncomment to override:
# W2A_CDP_PORT=9222
# W2A_PORT=8080
# W2A_HOST=127.0.0.1
# W2A_HEADLESS=false
# W2A_CHROME_EXTRA_ARGS="--no-sandbox --disable-dev-shm-usage"
# W2A_LOG_LEVEL=INFO

# Security note:
# You may bind W2A_HOST=0.0.0.0 for trusted LAN access, but do not publish or
# port-forward Chrome's CDP port (9222). It controls the logged-in browser.
